{
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://medichronicle-backend.onrender.com/api/v1/$1"
    },
    {
      "source": "/api/v1",
      "destination": "https://medichronicle-backend.onrender.com/api/v1/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
