# =================================================================
# MediChronicle AI — Global Environment Variables Example
# Copy this file to .env and adjust values for your environment.
# NEVER commit your actual .env file or sensitive keys to Git.
# =================================================================

# -----------------------------------------------------------------
# Backend Configuration (FastAPI)
# -----------------------------------------------------------------
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default: sqlite:///./medichronicle.db
# Cloud PostgreSQL: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./medichronicle.db

# Storage Directories
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# Allowed CORS Origins (comma-separated, e.g. https://your-frontend.vercel.app or * for all)
ALLOWED_ORIGINS=*

# -----------------------------------------------------------------
# Frontend Configuration (Vite + React)
# -----------------------------------------------------------------
# Leave empty for local development (uses Vite proxy to http://127.0.0.1:8000)
# Set to deployed backend URL for production (e.g. https://medichronicle-backend.onrender.com)
VITE_API_URL=
