# =================================================================
# Backend Environment Variables (.env)
# =================================================================
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection String
# Local SQLite: sqlite:///./medichronicle.db
# PostgreSQL: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./medichronicle.db

# Storage Directories
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# Allowed CORS Origins (comma-separated for specific domains or * for dev)
ALLOWED_ORIGINS=*
